[Unit]
Description=UniversalSync Discovery Server
After=network.target
Documentation=man:stdiscosrv(1)

[Service]
WorkingDirectory=/var/lib/universalsync-discosrv
EnvironmentFile=/etc/default/universalsync-discosrv
ExecStart=/usr/bin/stdiscosrv $DISCOSRV_OPTS

# Hardening
User=universalsync-discosrv
Group=universalsync
ProtectSystem=strict
ReadWritePaths=/var/lib/universalsync-discosrv
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
Alias=universalsync-discosrv.service
