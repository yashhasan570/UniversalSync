[Unit]
Description=Universal Sync Discovery Server
After=network.target
Documentation=man:stdiscosrv(1)

[Service]
WorkingDirectory=/var/lib/universal sync-discosrv
EnvironmentFile=/etc/default/universal sync-discosrv
ExecStart=/usr/bin/stdiscosrv $DISCOSRV_OPTS

# Hardening
User=universal sync-discosrv
Group=universal sync
ProtectSystem=strict
ReadWritePaths=/var/lib/universal sync-discosrv
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
Alias=universal sync-discosrv.service
