[Unit]
Description=Universal Sync Relay Server
After=network.target
Documentation=man:strelaysrv(1)

[Service]
WorkingDirectory=/var/lib/universal sync-relaysrv
EnvironmentFile=/etc/default/universal sync-relaysrv
ExecStart=/usr/bin/strelaysrv -nat=${NAT} $RELAYSRV_OPTS

# Hardening
User=universal sync-relaysrv
Group=universal sync
ProtectSystem=strict
ReadWritePaths=/var/lib/universal sync-relaysrv
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
Alias=universal sync-relaysrv.service
