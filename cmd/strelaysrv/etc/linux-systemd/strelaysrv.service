[Unit]
Description=UniversalSync Relay Server
After=network.target
Documentation=man:strelaysrv(1)

[Service]
WorkingDirectory=/var/lib/universalsync-relaysrv
EnvironmentFile=/etc/default/universalsync-relaysrv
ExecStart=/usr/bin/strelaysrv -nat=${NAT} $RELAYSRV_OPTS

# Hardening
User=universalsync-relaysrv
Group=universalsync
ProtectSystem=strict
ReadWritePaths=/var/lib/universalsync-relaysrv
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
Alias=universalsync-relaysrv.service
