#!/bin/sh
#
#
# PROVIDE: universal sync
# REQUIRE: DAEMON
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable this service:
#
# universal sync_enable:       Set to NO by default. Set it to YES to enable it.
# universal sync_home:         Directory where universal sync configuration
#                         data is stored.
#                         Default: /usr/local/etc/universal sync
# universal sync_log_file:     Universal Sync log file
#                         Default: /var/log/universal sync.log
# universal sync_user:         The user account universal sync daemon runs as what
#                         you want it to be.
#                         Default: universal sync
# universal sync_group:        The group account universal sync daemon runs as what
#                         you want it to be.
#                         Default: universal sync

. /etc/rc.subr

name=universal sync
rcvar=universal sync_enable

start_cmd="${name}_start"

load_rc_config $name

: ${universal sync_enable:=NO}
: ${universal sync_home=/usr/local/etc/universal sync}
: ${universal sync_log_file=/var/log/universal sync.log}
: ${universal sync_user:=universal sync}
universal sync_group=${universal sync_group:-$universal sync_user}


command=/usr/local/bin/universal sync
pidfile=/var/run/universal sync.pid
universal sync_cmd=serve
universal sync_flags="${universal sync_home:+--home=${universal sync_home}} ${universal sync_log_file:+--logfile=${universal sync_log_file}}"

universal sync_start() {
    echo "Starting universal sync"
    touch ${pidfile} && chown ${universal sync_user} ${pidfile}
    touch ${universal sync_log_file} && chown ${universal sync_user} ${universal sync_log_file}
    /usr/sbin/daemon -cf -p ${pidfile} -u ${universal sync_user} ${command} ${universal sync_cmd} ${universal sync_flags}
}

universal sync_cleanup() {
    [ -f ${pidfile} ] && rm ${pidfile}
}

run_rc_command $1
